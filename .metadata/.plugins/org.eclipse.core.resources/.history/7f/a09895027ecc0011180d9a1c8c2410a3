package gettingstarted;

import java.util.regex.Pattern;

import org.testng.Assert;
import org.testng.annotations.Test;

import com.microsoft.playwright.Browser;
import com.microsoft.playwright.BrowserType;
import com.microsoft.playwright.Page;
import com.microsoft.playwright.Playwright;
import com.microsoft.playwright.assertions.PlaywrightAssertions;
import com.microsoft.playwright.options.WaitUntilState;

public class LoginLogoutWithTestNg {
	@Test
	public void loginTest(){
		
		Browser browser=null;
		Page page=null;
		try {
		
		 browser = Playwright.create().chromium().launch(new BrowserType.LaunchOptions().setHeadless(false).setSlowMo(1000));
	 page = browser.newPage();
		page.navigate("https://freelance-learn-automation.vercel.app/login");
		
		//ASS1
		Assert.assertEquals(page.title(), "Learn Automation Courses");
		page.waitForTimeout(30000);
		PlaywrightAssertions.assertThat(page).hasTitle("Learn Automation Courses");
		 
		 page.navigate("https://freelance-learn-automation.vercel.app/login",
				    new Page.NavigateOptions().setWaitUntil(WaitUntilState.DOMCONTENTLOADED));
		
		
		page.getByPlaceholder("Enter Email").fill("admin@email.com");
		page.getByPlaceholder("Enter Password").fill("admin@123");
		page.getByText("Sign in").nth(1).click();
		
		//ASS2
		Assert.assertTrue(page.getByText("Welcome Admin Manager to Learn Automation Courses").isVisible());
	
		PlaywrightAssertions.assertThat(page.locator(".welcomeMessage")).containsText("Welcome");//selector debugger mode is not understandable
		
		page.getByAltText("menu").click();
		page.getByText("Sign out").click();
		
		//ASS3
		Assert.assertEquals(page.url().contains("login"), true);
		PlaywrightAssertions.assertThat(page).hasURL(Pattern.compile("login"));//after signing out url will change to login again
		}
		finally {
		page.close();
		browser.close();
		
		
		}
		
		
	}

}

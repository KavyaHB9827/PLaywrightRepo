package gettingstarted;
import java.util.regex.Pattern;

//practise page
import com.microsoft.playwright.Browser;

import com.microsoft.playwright.BrowserType;
import com.microsoft.playwright.Page;
import com.microsoft.playwright.Playwright;
import com.microsoft.playwright.assertions.PlaywrightAssertions;

public class LoginLogout {
	

	public static void main(String[] args) {
		Browser browser=null;
		Page page=null;
		
		try {
			

 browser = Playwright.create().chromium().launch(new BrowserType.LaunchOptions().setHeadless(false));
	 page=browser.newPage();
	page.navigate("https://freelance-learn-automation.vercel.app/login");
	PlaywrightAssertions.assertThat(page).hasTitle(" Learn Automation Courses ");//by default playwright assertions wait for 5 seconds
	page.waitForTimeout(30000);//only for debugging and holds good for page elements
	
	//page.locator("#email").fill("admin@email.com");//id locator
	//page.locator("xpath=//input[@name='email1']").fill("admin@email.com");
	//page.locator("css=input[name='email1']").fill("admin@email.com");
	
	page.getByPlaceholder("Enter Email").fill("admin@email.com");
	page.getByPlaceholder("Enter Password").fill("admin@123");
	page.getByText("Sign in").nth(1).click();
	//page.getByText("Sign in").last().click();
	
	PlaywrightAssertions.assertThat(page.locator("Welcome Admin Manager to Learn Automation Courses")).containsText("Welcome"); 
	page.getByAltText("menu").click();
	page.getByText("Sign out").click();
	
	
	PlaywrightAssertions.assertThat(page).hasURL(Pattern.compile("login"));//exact url can also be given
	
		}
		finally {
	page.close();
	browser.close(); 
		}  
	}
	
}

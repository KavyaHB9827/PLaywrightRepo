package gettingstarted;

import java.util.regex.Pattern;

import com.microsoft.playwright.Browser;
import com.microsoft.playwright.BrowserType;
import com.microsoft.playwright.Page;
import com.microsoft.playwright.Playwright;
import com.microsoft.playwright.assertions.PlaywrightAssertions;
import org.testng.Assert;

public class LoginLogout {

	public static void main(String[] args) {
		Browser browser = null;
		Page page = null;
		try {
		 browser = Playwright.create().chromium().launch(new BrowserType.LaunchOptions().setHeadless(false));
		 page = browser.newPage();
		page.navigate("https://freelance-learn-automation.vercel.app/login");
		
		//Assertion1
		//Assert.assertEquals(page.title(), "Learn Automation Courses");
		PlaywrightAssertions.assertThat(page).hasTitle("Learn Automation Courses");//by default playwright assertions wait for 5 second
		page.waitForTimeout(3000);//only for debugging
		
		//page.locator("#email1	").fill("admin@email.com");
		//page.locator("xpath=//input[@name='email1']").fill("admin@email.com");
		//page.locator("css=input[name='email1]").fill("admin@email.com");
		page.getByPlaceholder("Enter Email").fill("admin@email.com");
		page.getByPlaceholder("Enter Password").fill("admin@email.com");
		page.getByText("sign in").click();//once you login url will change to app you get welcome for each refresh and u get cart button so think and keep assertions accordingly
		
		//Assertion2
		//Assert.assertTrue(page.getByText("Welcome Admin Manager to Learn Automation Courses").isVisible());
		
		PlaywrightAssertions.assertThat(page.locator(".welcomeMessage")).containsText("Welcome");
	       page.getByAltText("menu").click();
	       page.getByText("Sign out").click();
	       
	       //ASSERTION3
	       //Assert.assertTrue(page.url().contains("login"));
	       PlaywrightAssertions.assertThat(page).hasURL(Pattern.compile("login"));
		
		}     
		finally {
		page.close();
		browser.close();
		
		}//by default playwright deos not terminates session even script fails so use finally block 
	}

}
